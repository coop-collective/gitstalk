+    async def _with_policy(self, tree: str) -> str:
+        """The seed tree with ``.gitstalk/policy.yml`` from ``policy_file`` (the arena has no .gitstalk/)."""
+        with open(self.policy_file, encoding="utf-8") as fh:
+            text = fh.read()
+        blob = (await self.git.out("hash-object", "-w", "--stdin", input_text=text)).strip()
+        sub = (await self.git.out("mktree", input_text=f"100644 blob {blob}\tpolicy.yml\n")).strip()
+        entries = [e for e in (await self.git.out("ls-tree", tree)).splitlines() if not e.endswith("\t.gitstalk")]
+        entries.append(f"040000 tree {sub}\t.gitstalk")
+        return (await self.git.out("mktree", input_text="\n".join(entries) + "\n")).strip()
