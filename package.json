{
  "name": "gitstalk",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm rust:check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=2 --if-present test && node --test scripts/*.test.mjs",
    "rust:check": "node scripts/rust-check.mjs",
    "product-events": "node scripts/product-events.mjs",
    "env:generate": "node scripts/environments.mjs generate",
    "env:provision": "node scripts/environments.mjs provision",
    "env:deploy": "node scripts/environments.mjs deploy",
    "env:verify": "node scripts/environments.mjs verify",
    "env:smoke": "node scripts/environments.mjs smoke",
    "env:secrets": "node scripts/environments.mjs secrets",
    "skills:update": "npx -y skills@latest update -p -y"
  },
  "devDependencies": {
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0"
}
