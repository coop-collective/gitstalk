// One Gitstalk environment. Copy this directory to environments/<name>/ (staging, production,
// or your own), fill in the account and subdomain, then:
//
//   pnpm env:provision <name>   create the D1, KV, R2, queues and Artifacts namespaces it needs,
//                               record their ids in resources.json, generate missing secrets,
//                               apply D1 migrations
//   pnpm env:deploy <name>      check the secrets, then deploy every package below in order
//   pnpm env:secrets <name>     push secrets to the Workers; --to-github <owner/repo> stores them
//                               as the GitHub environment secret GITSTALK_SECRETS_JSON for CI
//   pnpm env:smoke <name>       health, sign-up page, MCP metadata and docs on the live origins
//
// The public repo ignores environments/* except this example. In a (private) deploy repo,
// commit env.jsonc and resources.json with `git add -f environments/<name>/env.jsonc ...`; never
// commit environments/<name>/secrets/. See docs/claude-opus/30-environments.md.
{
  // The Cloudflare account every Wrangler command for this environment targets (wrangler whoami).
  "account_id": "00000000000000000000000000000000",
  // Replaces the templates' "gitstalk" in every Worker and resource name (optional). On an account
  // that already runs another Gitstalk environment, use a prefix or suffix of your own.
  "prefix": "gitstalk",
  // Appended to every Worker and resource name: "-staging" gives gitstalk-gateway-staging,
  // gitstalk-forge-staging, gitstalk-repos-staging... "" keeps the base names.
  "suffix": "-staging",
  // Whether search engines may index this deployment (true only for production): robots.txt
  // then lists the sitemap and only the app's private areas are disallowed. Unset or false, every
  // web response is `X-Robots-Tag: noindex` and robots.txt disallows everything (staging, forks).
  // "search_indexing": true,
  // Workers are reached at https://<worker>.<subdomain>.workers.dev unless `urls` names one.
  "workers_dev_subdomain": "your-subdomain",
  // Optional custom origins. Each one outside workers.dev becomes a Workers Custom Domain of its
  // package (the zone must be in this account); every URL var follows (clone URLs, MCP_URL,
  // DOCS_URL, the OAuth and OIDC issuers). A site on the web's origin is served by the web
  // (a SITE service binding) and gets no domain of its own.
  // "urls": {
  //   "web": "https://git.example.com",
  //   "site": "https://git.example.com",
  //   "mcp": "https://mcp.git.example.com",
  //   "gateway": "https://api.git.example.com",
  //   "ssh": "https://ssh.git.example.com",
  // },
  // Deployed in this order whatever the order here: actions-executor, gateway, mcp, site, web,
  // ssh.
  "packages": ["actions-executor", "gateway", "web", "mcp", "ssh", "site"],
  // Merged into each package's generated config: objects key by key, arrays of bindings or
  // containers by their binding / class_name, anything else replaced.
  "overrides": {
    "gateway": {
      "vars": { "RUNNER_MAX_INSTANCES": "4", "ACTIONS_MAX_INSTANCES": "2" },
      "containers": [{ "class_name": "Runner", "max_instances": 4 }],
    },
    "actions-executor": {
      "vars": { "ACTIONS_MAX_INSTANCES": "2" },
      "containers": [{ "class_name": "ActionsJobContainer", "max_instances": 2 }],
    },
    // Rate-limit namespaces are per account: give each environment its own. PLATFORM_ADMINS:
    // comma-separated handles that see /admin (benchmark runs, the race, the demo gate).
    // EMAIL_SENDER_DOMAIN turns on email sign-in codes, sent from Gitstalk <signin@<domain>>:
    // a zone in this account onboarded to Email Sending (`wrangler email sending enable
    // <domain>`). Empty: sign-in is passkeys only. Provision generates EMAIL_SIGNIN_KEY.
    "web": {
      "ratelimits": [{ "name": "SIGNIN_RATE_LIMIT", "namespace_id": "4102" }],
      "vars": { "PLATFORM_ADMINS": "", "EMAIL_SENDER_DOMAIN": "" },
    },
    // No Spectrum app in front of a test stack: reach the SSH server over GET /tunnel.
    "ssh": { "vars": { "SSH_TUNNEL": "on" } },
  },
}
