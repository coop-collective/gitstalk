{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A template: names are the base (production) names, ids are `local-*` placeholders and URLs
  // point at local dev. `pnpm env:generate <env>` writes wrangler.<env>.jsonc beside it with the
  // environment's suffixed names, ids and origins (docs/claude-opus/30-environments.md).
  "name": "gitstalk-web",
  // vinext's App Router handler behind worker/index.ts, which hands the marketing site's paths
  // to SITE when an environment binds it (one origin for both); the routes live in app/.
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "assets": { "directory": "dist/client", "not_found_handling": "none", "binding": "ASSETS" },
  // Live runs, decisions and the repository views come from the gateway over RPC (never HTTP).
  // MCP: the OAuth consent screen and connected agents (its AgentSessionsRpc).
  "services": [
    { "binding": "GATEWAY", "service": "gitstalk-gateway" },
    { "binding": "MCP", "service": "gitstalk-mcp" },
    // Actions (docs/claude-opus/25): the gateway's ActionsRpc on its named entrypoint.
    { "binding": "ACTIONS", "service": "gitstalk-gateway", "entrypoint": "Actions" },
  ],
  // Accounts (docs/claude-opus/19-accounts-and-auth.md): people, passkeys, sessions, tokens,
  // audit. The schema is packages/shared-identity/migrations; apply it from this package:
  // `wrangler d1 migrations apply gitstalk-identity --remote`.
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "gitstalk-identity",
      "database_id": "local-gitstalk-identity",
      "migrations_dir": "../shared-identity/migrations",
    },
  ],
  // Uploaded pictures (docs/claude-opus/29-settings.md): avatars, organisation icons, repository
  // social images, written and served by this Worker under /media (@gitstalk/shared-media).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gitstalk-media" }],
  // Cloudflare Images re-encodes uploads to WebP sizes (first frame of a GIF, metadata gone).
  // Without it the stripped original is stored and served at every size.
  "images": { "binding": "IMAGES" },
  // Sign-in endpoints: 10 attempts a minute per IP, and per email or handle.
  "ratelimits": [
    {
      "name": "SIGNIN_RATE_LIMIT",
      "namespace_id": "4101",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // Product analytics (docs/claude-opus/19 §10): sign-up, connect, repository created. The
  // dataset is created on first write; `scripts/product-events.mjs` reads the counts.
  "analytics_engine_datasets": [{ "binding": "PRODUCT_EVENTS", "dataset": "product_events" }],
  "vars": {
    "LOG_LEVEL": "info",
    // How Ask turns a question into a view spec: "keywords" (deterministic, the default) or
    // "workers-ai", which also needs an `ai` binding named AI (see README).
    "ASK_CLASSIFIER": "keywords",
    "ASK_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    // Who decides what the Plot shows (docs/claude-opus/14 §5): "jev" (TypeSafe's Jev on
    // Workers AI, through the AI Gateway named in JEV_GATEWAY; unified billing) or "rules".
    // Any Jev failure falls back to the rules, and every pick leaves a receipt.
    "PICKER": "jev",
    "JEV_GATEWAY": "default",
    // Email sign-in (six-digit codes, docs/claude-opus/19 §6): the domain mail comes from
    // (`Gitstalk <signin@<domain>>`), onboarded to Cloudflare Email Sending. Empty: email
    // sign-in is off and hidden. Set per environment (env.jsonc overrides.web.vars). Also needs
    // the EMAIL binding below and the EMAIL_SIGNIN_KEY secret (HMAC key for codes).
    "EMAIL_SENDER_DOMAIN": "",
    // Turnstile on sign-in and sign-up (docs/claude-opus/19 §5): on only when BOTH this site
    // key and the TURNSTILE_SECRET_KEY secret are set; with either missing it is off (logged).
    // To turn it on: create a managed widget for this deployment's hostname, set its site key
    // here and `wrangler secret put TURNSTILE_SECRET_KEY`. TURNSTILE_HOSTNAMES (comma-separated) defaults to the request's own
    // host. TURNSTILE_TEST_KEYS=allow accepts Cloudflare's test keys (staging only, never live).
    "TURNSTILE_SITE_KEY": "",
    "TURNSTILE_HOSTNAMES": "",
    "TURNSTILE_TEST_KEYS": "",
    // Repositories (docs/claude-opus/20-repositories.md): the public addresses a new repository's
    // start page prints. Git is served by this host, as on GitHub: `<GIT_ORIGIN>/<owner>/<repo>.git`
    // (app/[owner]/[repo]/{info/refs,git-upload-pack,git-receive-pack} forward to the gateway).
    "GIT_ORIGIN": "http://localhost:5173",
    "MCP_URL": "http://localhost:8788/mcp",
    // The public docs on the marketing site (packages/site), linked from the header's menu.
    "DOCS_URL": "http://localhost:8790/docs/",
    // This deployment's own origin: canonical links, og:url, robots.txt and sitemap.xml
    // (src/site/search.ts). SEARCH_INDEXING "on" lets search engines index it (env.jsonc
    // `search_indexing: true`, production only); anything else answers robots.txt with
    // `Disallow: /` and marks every response `X-Robots-Tag: noindex`.
    "WEB_URL": "http://localhost:5173",
    "SEARCH_INDEXING": "off",
    // Git over SSH (`ssh://git@<SSH_HOST>/<owner>/<repo>.git`): empty until the SSH endpoint is
    // live; /gitstalk:setup then finishes with HTTPS and a token (docs/claude-opus/19).
    "SSH_HOST": "",
    // The SSH host key's fingerprint (`SHA256:…`, as `ssh` prints it), shown in Settings → SSH
    // keys and on a new repository's page so people can check it (docs/claude-opus/21).
    "SSH_HOST_KEY_FINGERPRINT": "",
    // Actions (docs/claude-opus/25): where the Automations tab reads workflows and runs.
    // "gateway": the gateway's Actions control plane (the ACTIONS binding). "fixtures": the
    // web's own fake (src/actions/fake), for a staging stack without one; every page says so.
    // Empty: the tab says Actions are not running on this deployment.
    "ACTIONS_SOURCE": "gateway",
    // Platform admins (docs/claude-opus/19 §11): comma-separated handles that see /admin (the
    // benchmark runs, the race and the demo gate). Empty: nobody; everyone else gets a 404 there.
    // Set it per environment in env.jsonc: overrides.web.vars.PLATFORM_ADMINS.
    "PLATFORM_ADMINS": "",
  },
  // Workers AI: Jev (typesafe/jev) for the picker, and the optional Ask classifier model.
  // Billed to the account; no API key is involved. `remote` makes local dev call it too.
  "ai": { "binding": "AI", "remote": true },
  // Cloudflare Email Service (Email Sending): sign-in codes. Locally Miniflare simulates it and
  // prints where it saved each message, so `vite dev` sends nothing.
  "send_email": [{ "name": "EMAIL" }],
  // DEMO_PASSWORD gates decisions (cookie after the login form). EMAIL_SIGNIN_KEY is the HMAC
  // key for email sign-in codes and pending sign-ups (random; `pnpm env:provision` generates
  // it). Locally they come from .dev.vars (see .dev.vars.example).
  "secrets": { "required": ["DEMO_PASSWORD", "EMAIL_SIGNIN_KEY"] },
}
