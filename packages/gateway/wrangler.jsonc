{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A template: names are the base (production) names, ids are `local-*` placeholders and URLs
  // point at local dev. `pnpm env:generate <env>` writes wrangler.<env>.jsonc beside it with the
  // environment's suffixed names, ids and origins (docs/claude-opus/30-environments.md).
  "name": "gitstalk-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": {
    "LOG_LEVEL": "info",
    // Must match the namespace of the ARTIFACTS binding below; the git proxy serves /git/<namespace>/.
    "ARTIFACTS_NAMESPACE": "gitstalk-race",
    "RUN_TOKEN_TTL_SECONDS": "3600",
    // §3: per-job Artifacts tokens live at most 10 minutes.
    "ARTIFACTS_TOKEN_TTL_SECONDS": "600",
    // The web app, named in the hint a request without a usable credential gets.
    "WEB_URL": "http://localhost:5173",
    // The runner pool races and repositories share (RunnerCapacity): containers[].max_instances.
    "RUNNER_MAX_INSTANCES": "48",
    // This Worker's own origin: git checkout URLs, live log sockets and GITHUB_SERVER_URL for
    // Actions jobs (docs/claude-opus/25-actions-and-automations.md).
    "PUBLIC_URL": "http://localhost:8787",
    // Actions (doc 25 §3.8, D9): "stub" runs jobs on the built-in echo executor; "service" calls
    // the ACTIONS_EXECUTOR service binding (gitstalk-actions-executor, one container per job,
    // docs/claude-opus/26-actions-job-executor.md). Limits are per repository.
    "ACTIONS_EXECUTOR_MODE": "service",
    // The executor's container class max_instances: RunnerCapacity holds Actions leases to it.
    "ACTIONS_MAX_INSTANCES": "16",
    "ACTIONS_MONTHLY_MINUTES": "100",
    "ACTIONS_JOB_TIMEOUT_MINUTES": "60",
    "ACTIONS_CONCURRENT_JOBS": "4",
    // Automations (doc 25 §7.5): the agent's model calls go through this AI Gateway, by the
    // AI binding (no key anywhere), and each repository may spend this much a month on them.
    "AUTOMATIONS_AI_GATEWAY": "default",
    "AUTOMATIONS_MONTHLY_USD": "10",
  },
  // Workers AI, only for automations' model proxy (owner's exception of 2026-10-09, doc 25 §7.5).
  "ai": { "binding": "AI" },
  // The Actions job executor (packages/actions-executor); it calls back through this Worker's
  // `ActionsJobs` entrypoint. Deploy it with (or before) a gateway in "service" mode.
  "services": [{ "binding": "ACTIONS_EXECUTOR", "service": "gitstalk-actions-executor" }],
  // ADMIN_TOKEN guards the admin API; RUN_TOKEN_SECRET signs slot, seed and view tokens.
  // Locally they come from .dev.vars (see .dev.vars.example); remotely from `wrangler secret put`.
  // ACTIONS_SECRETS_KEY: 32 random bytes, base64; encrypts Actions secrets at rest (AES-GCM).
  "secrets": { "required": ["ADMIN_TOKEN", "RUN_TOKEN_SECRET", "ACTIONS_SECRETS_KEY"] },
  // The spend guards' hourly repo sweep (src/run/scheduled-sweep.ts): deletes race repos of
  // runs that began more than a day ago, and orphaned race repos. Nothing to provision.
  "triggers": { "crons": ["17 * * * *"] },
  // Durable Object classes exported from src/index.ts. `exports` replaces `migrations`.
  "exports": {
    "RunDO": { "type": "durable-object", "storage": "sqlite" },
    // Deprecated (2026-10-15): the run list and the kill switch moved to the FORGE D1 (`runs`,
    // `gateway_flags`) and the sweep to the cron below. Kept, read only, for one release so the
    // backfill can copy its rows; the next release deletes the class.
    "RunIndex": { "type": "durable-object", "storage": "sqlite" },
    "Runner": { "type": "durable-object", "storage": "sqlite" },
    // stream_diffs: one per run, beside its RunDO (docs/claude-17-streaming-diffs.md).
    "RunStreamDO": { "type": "durable-object", "storage": "sqlite" },
    // Derived history (blame by bean, path history): one per repository engine, fed by the
    // repo-events consumer (docs/claude-opus/34-derived-data-and-blame.md).
    "RepoDerivedDO": { "type": "durable-object", "storage": "sqlite" },
    // One instance ("pool"): race reservations and repositories' pre-land sandbox leases.
    "RunnerCapacity": { "type": "durable-object", "storage": "sqlite" },
    // Actions (doc 25 §3.1): one per repository (index, schedules, run numbers, minutes) and
    // one per workflow run (the job DAG, cancel, timeouts, the live log relay).
    "ActionsRepoDO": { "type": "durable-object", "storage": "sqlite" },
    "ActionsRunDO": { "type": "durable-object", "storage": "sqlite" },
  },
  "durable_objects": {
    "bindings": [
      { "name": "RUNS", "class_name": "RunDO" },
      { "name": "RUN_INDEX", "class_name": "RunIndex" },
      { "name": "RUNNER", "class_name": "Runner" },
      { "name": "RUN_STREAMS", "class_name": "RunStreamDO" },
      { "name": "DERIVED", "class_name": "RepoDerivedDO" },
      { "name": "RUNNER_CAPACITY", "class_name": "RunnerCapacity" },
      { "name": "ACTIONS_REPOS", "class_name": "ActionsRepoDO" },
      { "name": "ACTIONS_RUNS", "class_name": "ActionsRunDO" },
    ],
  },
  // Per run: one committer (squash, revert, update-ref), one instance per emulated CI slot,
  // and one sandbox per agent slot for v2's pre-land checks: agents + ci_slots + 1 (§5, §6).
  // A repository engine: committer + CI slots, plus one sandbox per bean in check, leased from
  // RunnerCapacity (RUNNER_MAX_INSTANCES above must equal max_instances).
  // standard-2 (1 vCPU): on standard-1 (1/2 vCPU) suites took 12.7 s median, 0.9 s locally.
  // 24 instances fit a 12-agent v2 run (15) beside a 12-agent queue run (3).
  "containers": [
    {
      "class_name": "Runner",
      "image": "./container/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-4",
      "max_instances": 48,
    },
  ],
  // Two namespaces, kept apart: ARTIFACTS holds race repos (`race-<run>`), which the hourly
  // sweep deletes once their race is over; REPOS holds people's repositories (`repo-<id>`),
  // which the sweep never lists (docs/claude-opus/20-repositories.md §2).
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "gitstalk-race", "remote": true },
    { "binding": "REPOS", "namespace": "gitstalk-repos", "remote": true },
  ],
  // repo-events (docs/claude-opus/20-repositories.md §6, backlog 2.6): repository engines send
  // landings, promotions, reverts, decisions and bean events; this Worker's own consumer
  // writes the D1 indexes (beans, decisions, repo_daily, repo_lines, activity). Batches do not
  // wait to fill (max_batch_timeout 0): delivery is the index's whole delay.
  "queues": {
    "producers": [{ "binding": "REPO_EVENTS", "queue": "gitstalk-repo-events" }],
    "consumers": [
      {
        "queue": "gitstalk-repo-events",
        "max_batch_size": 100,
        "max_batch_timeout": 0,
        "max_retries": 10,
      },
    ],
  },
  // The repository registry (FORGE, docs/claude-opus/20-repositories.md): records, per-owner
  // name uniqueness and repository activity; migrations in migrations/. Accounts (IDENTITY_DB):
  // git credentials may be people's tokens (bsu_, bss_), verified against the identity database
  // (packages/shared-identity, docs/claude-opus/19-accounts-and-auth.md).
  "d1_databases": [
    {
      "binding": "FORGE",
      "database_name": "gitstalk-forge",
      "database_id": "local-gitstalk-forge",
      "migrations_dir": "migrations",
    },
    {
      "binding": "IDENTITY_DB",
      "database_name": "gitstalk-identity",
      "database_id": "local-gitstalk-identity",
      "migrations_dir": "../shared-identity/migrations",
    },
  ],
  // Product analytics (docs/claude-opus/19 §10): a bean pushed to a person's repository. The
  // web app writes sign-up, connect and repository-created events to the same dataset.
  // Actions job logs: gzip chunks under <owner>/<repo>/<run>/<job>/, deleted after 30 days by
  // the bucket's lifecycle rule (`wrangler r2 bucket lifecycle add gitstalk-actions-logs
  // expire-logs --expire-days 30`). Never stored in Durable Objects.
  "r2_buckets": [{ "binding": "ACTIONS_LOGS", "bucket_name": "gitstalk-actions-logs" }],
  "analytics_engine_datasets": [{ "binding": "PRODUCT_EVENTS", "dataset": "product_events" }],
}
