{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A template: names are the base (production) names, ids are `local-*` placeholders and URLs
  // point at local dev. `pnpm env:generate <env>` writes wrangler.<env>.jsonc beside it with the
  // environment's suffixed names, ids and origins (docs/claude-opus/30-environments.md).
  "name": "gitstalk-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  // AsyncLocalStorage, which the Agents SDK's MCP handler uses. global_fetch_strictly_public:
  // the OAuth provider fetches Client ID Metadata Documents only from public addresses.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": {
    "LOG_LEVEL": "info",
    // This Worker's own origin: the OAuth issuer and the protected resource `<PUBLIC_URL>/mcp`.
    "PUBLIC_URL": "http://localhost:8788",
    // The web app the tools link to (`preview_url`, `preview_urls`) and where /authorize sends
    // people to sign in and approve a client (`/connect`).
    "WEB_URL": "http://localhost:5173",
    // Where git is served (the web host, as on GitHub): clone URLs and the host of
    // git_credentials' credential.
    "GIT_ORIGIN": "http://localhost:5173",
    // The run OAuth sessions read when a tool names no repository (`repo`). Empty: the newest
    // run the gateway lists.
    "DEMO_RUN": "",
    // Ask's classifier, as in packages/web: keywords unless an AI binding is added.
    "ASK_CLASSIFIER": "keywords",
    "ASK_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    // Who orders what ask_repo returns, as in packages/web: "clef" (Clef Flash on Workers AI
    // through the AI Gateway in DECISION_GATEWAY; the default), "clef-27b", "jev" or "rules".
    // Answers carry the receipts either way.
    "PICKER": "clef",
    "DECISION_GATEWAY": "default",
  },
  // Workers AI, for Clef; billed to the account, no API key involved.
  "ai": { "binding": "AI", "remote": true },
  // Every read goes through the gateway over RPC; the run-token check too (`verifyMcpToken`).
  "services": [{ "binding": "GATEWAY", "service": "gitstalk-gateway" }],
  // OAuth clients, grants and tokens (@cloudflare/workers-oauth-provider stores only hashes),
  // plus pending consent requests. KV namespace `gitstalk-oauth`.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-gitstalk-oauth" }],
  // Accounts (docs/claude-opus/19-accounts-and-auth.md): grants are audited here and session
  // git tokens minted here. Schema: packages/shared-identity/migrations.
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "gitstalk-identity",
      "database_id": "local-gitstalk-identity",
      "migrations_dir": "../shared-identity/migrations",
    },
  ],
}
